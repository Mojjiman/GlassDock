<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- ManagedShell uses System.Windows.Forms.NativeWindow internally. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn from build/icon/icon.html by build/icon/make-icon.mjs. -->
    <ApplicationIcon>GlassDock.ico</ApplicationIcon>
    <StartupObject>GlassDock.Program</StartupObject>
    <RootNamespace>GlassDock</RootNamespace>
    <AssemblyName>GlassDock</AssemblyName>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- WPF Fluent theme is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinForms is referenced only for ManagedShell; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Glass\Shaders\LiquidLens.hlsl" LogicalName="GlassDock.LiquidLens.hlsl" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
</Project>
